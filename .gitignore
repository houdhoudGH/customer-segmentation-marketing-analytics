# ============================================================
#  .gitignore — Customer Segmentation & Marketing Analytics
# ============================================================

# -------- Python --------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# -------- Virtual environments --------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# -------- Jupyter --------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
.jupyter/

# -------- IDE / Editor --------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# -------- Data files (uncomment to keep raw data out of repo) --------
# *.csv
# *.xlsx
# *.parquet
# *.json
# *.pkl
# *.pickle
# data/raw/
# data/processed/

# -------- Model artifacts --------
*.h5
*.pt
*.pth
*.joblib
*.model
models/

# -------- Logs & temporary files --------
*.log
logs/
tmp/
temp/
.cache/

# -------- OS junk --------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# -------- Secrets (never commit API keys!) --------
.env
.env.local
.env.*.local
secrets.json
config.local.*
credentials.json
*.key
*.pem
